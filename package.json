{
  "name": "noveltl-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Electron desktop interface for NovelTL",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "check": "node --check electron/main.cjs && node --check electron/preload.cjs && node --check src/app.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "io.noveltl.desktop",
    "productName": "NovelTL",
    "files": [
      "electron/**",
      "src/**"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*.py"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    }
  }
}
